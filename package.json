{
  "name": "lumen-newtab",
  "private": true,
  "version": "1.0.0",
  "description": "Page Nouvel onglet pour Chrome : heure, recherche, raccourcis en groupes et fond personnalisé.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs",
    "version": "node scripts/sync-version.mjs && git add public/manifest.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "lucide-preact": "^1.52.0",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
